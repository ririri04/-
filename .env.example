# note.com のユーザー名 (https://note.com/<username> の <username> 部分)
NOTE_USERNAME=your_note_username

# AI画像選定用 (Anthropic Claude API)
# https://console.anthropic.com/ でAPIキーを発行してください
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# X (Twitter) API v1.1/v2 - OAuth1.0a ユーザーコンテキスト用キー
# https://developer.twitter.com/en/portal/dashboard でアプリを作成し、
# 「Read and Write」権限のアクセストークンを発行してください
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Instagram API (Instagramビジネスログイン)
# Instagramプロアカウントのみで取得可能(Facebookページ連携は不要)
# https://developers.facebook.com/ でアプリを作成し、「Instagram API」ユースケースから
# アクセストークンを発行してください
IG_ACCESS_TOKEN=
IG_USER_ID=

# 投稿先の有効/無効 (true/false)
POST_TO_X=true
POST_TO_INSTAGRAM=true

# Instagramに投稿する画像の枚数(1記事から選ぶ枚数。カルーセル投稿になる)
INSTAGRAM_IMAGE_COUNT=5

# 投稿済み記事を記録するJSONファイルのパス
STATE_FILE=state.json

# true にすると実際には投稿せず、選定結果だけログに表示する
DRY_RUN=false
